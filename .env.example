# Copy to .env and fill in. Used by docker-compose and the backend (backend/app/config.py).

# Database (defaults to local SQLite if unset when running the backend directly)
DATABASE_URL=postgresql://postgres:postgres@db:5432/emailagent

# Redis broker/result backend for Celery
REDIS_URL=redis://redis:6379/0

# NVIDIA NIM (required for AI email generation)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Security
SECRET_KEY=change-me-in-production
# IMPORTANT: a 32-byte url-safe base64 Fernet key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank the backend generates an ephemeral key at startup, which makes any
# Gmail app passwords stored in a previous run undecryptable. Set this in any real deployment.
ENCRYPTION_KEY=

# Sending safeguards (optional overrides)
MAX_EMAILS_PER_HOUR=50
MAX_EMAILS_PER_DAY=400

# Frontend -> backend API base (note the /api suffix)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
